# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/y2k_shopping

# For development with SQLite (easier to start)
# DATABASE_URL=sqlite:///./y2k_shopping.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Y2K Shopping API
DEBUG=True

# CORS Origins (frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:2000"]

# Stripe (when ready to integrate)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
